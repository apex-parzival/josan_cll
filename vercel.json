{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:slug(artificial-grass-installation-turf|basement-renovation-home|basement-renovations|bobcat-service|deck-building-services|decking|fencing-services|flower-bed|framing-service|garage|gate-building|gazebo|kitchen-service|lot-gardening|new-basement-construction|painting-service|patios|pergola-services|professional-home-renovation|railing|retaining-walls|rock|sod|trees)",
      "destination": "/services/:slug",
      "permanent": true
    },
    {
      "source": "/(about|about-us|contact|contact-us|home|services|our-services)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(testimonials|review|google-reviews)",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/(portfolio|projects|our-work|photo-gallery)",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/services/basement-renovation",
      "destination": "/services/basement-renovations",
      "permanent": true
    }
  ]
}
